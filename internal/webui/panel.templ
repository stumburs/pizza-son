package webui

templ PanelPage() {
	@Layout("Panel · pizza-son", "/panel", "panel", "panel", panelContent())
}

templ panelContent() {
	<div class="main" id="app">
		<div id="loginScreen" class="login-screen">
			<h1>Control panel</h1>
			<p id="loginDesc">Log in with your Twitch account to manage commands and listeners.</p>
			<button class="login-btn" id="loginBtn" onclick="login()">
				<svg viewBox="0 0 24 24"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.428l-3 3v-3H6.857V1.714h13.714Z"/></svg>
				<span id="loginBtnText">Log in with Twitch</span>
			</button>
			<div id="loginLoading" class="loading-text hidden"><span class="spinner"></span> Completing login...</div>
		</div>

		<div id="panelView" class="hidden">
			<div class="header">
				<h1>Control panel</h1>
				<div class="user-info">
					<span id="userDisplay"></span>
					<button class="logout-btn" onclick="logout()">Log out</button>
				</div>
			</div>

			<div class="channel-bar" id="channelBar"></div>

			<div class="panel-tabs" role="tablist" aria-label="Panel sections">
				<button class="panel-tab active" id="tabBtnSettings" role="tab" aria-selected="true" onclick="selectPanelTab('settings')">Commands and listeners</button>
				<button class="panel-tab" id="tabBtnBertcheck" role="tab" aria-selected="false" onclick="selectPanelTab('bertcheck')">Bertcheck</button>
			</div>

			<div id="settingsTab" class="panel-tab-view">
				<div class="panel-box">
					<h2>Commands <span id="cmdCount"></span></h2>
					<div id="commandsList" class="loading">Loading commands...</div>
				</div>

				<div class="panel-box">
					<h2>Listeners <span id="listenerCount"></span></h2>
					<div id="listenersList" class="loading">Loading listeners...</div>
				</div>

				<div class="save-bar">
					<div id="saveStatus"></div>
					<button class="save-btn" id="saveBtn" onclick="saveChanges()">Save Changes</button>
				</div>
			</div>

			<div id="bertcheckTab" class="panel-tab-view hidden">
				<div class="panel-box">
					<h2>Channel overview <span id="bertOverviewMeta"></span></h2>
					<div id="bertOverview" class="loading">Loading bertcheck data...</div>
				</div>

				<div class="panel-box">
					<h2>User activity</h2>
					<div class="bert-controls">
						<label class="field">
							<span>User</span>
							<select id="bertUserSelect"></select>
						</label>
						<button class="btn" onclick="loadBertUser()">Inspect user</button>
						<button class="btn" onclick="loadBertOverview()">Refresh</button>
					</div>
					<div id="bertUserSummary"></div>
					<div id="bertRecords"></div>
					<div id="bertLog"></div>
				</div>

				<div class="panel-box">
					<h2>Purge activations</h2>
					<p class="hint">Deletes the selected user's bertchecks in the range and updates every total, record and timeline. The activation log must cover the range unless partial removal is allowed. Use the approximate option for older data that predates the log.</p>
					<div class="bert-controls">
						<label class="field">
							<span>From</span>
							<input type="datetime-local" id="bertFrom"/>
						</label>
						<label class="field">
							<span>Until</span>
							<input type="datetime-local" id="bertUntil"/>
						</label>
						<label class="field">
							<span>Berts to remove</span>
							<input type="number" id="bertCount" min="1" step="1" placeholder="Estimate from activity" disabled/>
						</label>
					</div>
					<label class="check">
						<input type="checkbox" id="bertPartial"/>
						Allow partial range (the activation log starts later)
					</label>
					<label class="check">
						<input type="checkbox" id="bertApproximate" onchange="toggleBertApproximate()"/>
						Approximate purge for data before the activation log (randomly removes berts)
					</label>
					<p class="hint">Leave "Berts to remove" blank to estimate the count from the user's hourly activity.</p>
					<div class="bert-actions">
						<button class="btn" onclick="setBertLastHours(2)">Set last 2h</button>
						<button class="btn" onclick="setBertLastHours(24)">Set last 24h</button>
						<button class="btn primary" onclick="purgeBertUser()">Purge range</button>
						<button class="btn danger" onclick="deleteBertUser()">Delete user entirely</button>
					</div>
					<div id="bertActionStatus" class="bert-status"></div>
				</div>
			</div>
		</div>
	</div>
}
